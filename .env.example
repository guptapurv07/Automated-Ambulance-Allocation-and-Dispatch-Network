# --- Database -------------------------------------------------------------
# With Docker (docker-compose.yml), DB_PASSWORD is also the password of the
# MySQL inside Docker, and the host, port, user and Redis are set there.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ambulance_dispatch

# --- Allocation -----------------------------------------------------------
# none        : no locking (unsafe baseline, used later to demonstrate races)
# for_update  : SELECT ... FOR UPDATE  (default, safe)
# skip_locked : SELECT ... FOR UPDATE SKIP LOCKED
LOCKING_MODE=for_update

# Average ambulance speed in km/h, used for ETA estimation.
AVG_SPEED_KMPH=32

# --- Simulation clock -----------------------------------------------------
# Advances dispatches through their lifecycle so ambulances return to service.
SIM_CLOCK_ENABLED=true
# 60.0 = one simulated minute per real second.
SIM_TIME_SCALE=60.0
SIM_TICK_SECONDS=1.0

# --- Concurrency ----------------------------------------------------------
# Worker threads draining the dispatch queue.
WORKER_POOL_SIZE=4

# Widens the read-to-write window so the unsafe baseline fails reproducibly.
# Leave at 0 for normal operation; the benchmark sets it per run.
RACE_WINDOW_MS=0

# --- Redis ----------------------------------------------------------------
# Empty: one server process keeps its queue, the duplicate check's lock and
# the clock in its own memory (the default). Set it to run several server
# processes side by side, sharing all three, for example:
#   REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# --- Deduplication --------------------------------------------------------
# Merges repeat reports of one emergency into a single incident.
# false = every call becomes its own incident (unsafe baseline for the benchmark).
DEDUP_ENABLED=true

# --- Scheduling -----------------------------------------------------------
# fifo = arrival order, priority = most severe first,
# llf = Least Laxity First (least spare time before its deadline).
QUEUE_SCHEDULER=llf

# greedy = nearest free ambulance, lookahead = nearest few ordered by how little
# their departure hurts the next call (see app/policy/lookahead.py), learned = the
# same few scored with weights trained by reinforcement learning (app/policy/learned.py).
DISPATCH_POLICY=greedy
LOOKAHEAD_BETA=1.25

# Longest wait for a row lock, in seconds (MySQL's own default is 50).
LOCK_WAIT_TIMEOUT_SECONDS=3

# --- Service area ---------------------------------------------------------
# Calls from outside this box are refused. Default: Dehradun and nearby towns.
SERVICE_AREA_LAT_MIN=30.10
SERVICE_AREA_LAT_MAX=30.50
SERVICE_AREA_LON_MIN=77.75
SERVICE_AREA_LON_MAX=78.25

# --- Docker only ----------------------------------------------------------
# Time zone of the containers, for the log times (default Asia/Kolkata).
# TZ=Asia/Kolkata
